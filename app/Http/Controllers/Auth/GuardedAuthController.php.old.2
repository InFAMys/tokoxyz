<?php

namespace App\Http\Controllers\Auth;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Hash;
use Illuminate\Validation\Rule;

abstract class GuardedAuthController extends Controller
{
    /** Guard name as defined in config/auth.php, e.g. 'admin' */
    protected string $guard;

    /** Column used to log in — differs per role: 'email', 'username', 'phone', etc. */
    protected string $credentialField = 'email';

    /** Fully qualified model class, e.g. App\Models\Admin::class */
    protected string $model;

    /** Database table name, e.g. 'admins' */
    protected string $table;

    /** Blade view for the login form, e.g. 'admin.auth.login' */
    protected string $loginView;

    /** Blade view for the register form, e.g. 'admin.auth.register' */
    protected string $registerView;

    /** Named route to redirect to after login/register, e.g. 'admin.dashboard' */
    protected string $dashboardRoute;

    /** Named route for this guard's login page, e.g. 'admin.login' */
    protected string $loginRoute;

    public function showLogin()
    {
        return view($this->loginView);
    }

    public function login(Request $request)
    {
        $field = $this->credentialField;

        $credentials = $request->validate([
            $field => ['required', $field === 'email' ? 'email' : 'string'],
            'password' => ['required'],
        ]);

        if (Auth::guard($this->guard)->attempt($credentials, $request->boolean('remember'))) {
            $request->session()->regenerate();

            return redirect()->intended(route($this->dashboardRoute));
        }

        return back()
            ->withErrors([$field => 'These credentials do not match our records.'])
            ->onlyInput($field);
    }

    public function showRegister()
    {
        return view($this->registerView);
    }

    public function register(Request $request)
    {
        $field = $this->credentialField;

        $data = $request->validate([
            'name' => ['required', 'string', 'max:255'],
            $field => [
                'required', 'string', 'max:255',
                $field === 'email' ? 'email' : 'string',
                Rule::unique($this->table, $field),
            ],
            'password' => ['required', 'string', 'min:8'],
        ]);

        $model = $this->model;

        $user = $model::create([
            'name' => $data['name'],
            $field => $data[$field],
            'password' => Hash::make($data['password']),
        ]);

        Auth::guard($this->guard)->login($user);

        $request->session()->regenerate();

        return redirect()->route($this->dashboardRoute);
    }

    public function registerPegawai(Request $request)
    {
        $field = $this->credentialField;

        $data = $request->validate([
            'nama_pegawai' => ['required', 'string', 'max:255'],
            'username_pegawai' => ['required', 'string', 'max:255'],
            'password' => ['required', 'string', 'min:8'],
        ]);

        $model = $this->model;

        $user = $model::create([
            'name' => $data['name'],
            $field => $data[$field],
            'password' => Hash::make($data['password']),
        ]);

        Auth::guard($this->guard)->login($user);

        $request->session()->regenerate();

        return redirect()->route($this->dashboardRoute);
    }

    public function logout(Request $request)
    {
        Auth::guard($this->guard)->logout();

        $request->session()->invalidate();
        $request->session()->regenerateToken();

        return redirect()->route($this->loginRoute);
    }
}